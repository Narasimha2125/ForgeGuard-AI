# ForgeGuard AI Environment Configuration

# Flask application secret key
SECRET_KEY=generate_a_secure_random_key_here

# Flask environment
FLASK_DEBUG=0
FLASK_APP=run.py

# MySQL Database connection (uncomment and customize for MySQL)
# DATABASE_URL=mysql+pymysql://forgeguard_user:your_secure_password@localhost:3306/forgeguard_db?charset=utf8mb4

# SQLite local fallback (default for rapid local setup)
DATABASE_URL=sqlite:///forgeguard_dev.db

# Storage and extraction limits
MAX_UPLOAD_SIZE_MB=500
MAX_FILE_EXTRACTION_MB=100
MAX_TOTAL_EXTRACTION_MB=1000
MAX_ARCHIVE_FILES=25000
SCAN_TIMEOUT_SECONDS=300

# Dependency Vulnerability Intelligence API (Free & Open Source)
OSV_API_URL=https://api.osv.dev/v1/query

# Optional GitHub Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
